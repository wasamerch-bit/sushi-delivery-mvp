{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "order.created",
  "type": "object",
  "required": [
    "event_id",
    "source",
    "timestamp",
    "order"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "order": {
      "type": "object",
      "required": [
        "order_id",
        "channel",
        "items"
      ],
      "properties": {
        "order_id": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "channel_order_id": {
          "type": "string"
        },
        "customer_name": {
          "type": "string"
        },
        "customer_phone": {
          "type": "string"
        },
        "delivery_address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "zip": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "lat": {
              "type": "number"
            },
            "lng": {
              "type": "number"
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "qty",
              "prep_time",
              "station"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "qty": {
                "type": "integer"
              },
              "prep_time": {
                "type": "integer"
              },
              "station": {
                "type": "string"
              }
            }
          }
        },
        "requested_time": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "integer"
        }
      }
    }
  }
}